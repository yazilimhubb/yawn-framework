{
  "name": "yawn-framework",
  "version": "0.2.2",
  "private": false,
  "description": "A TypeScript HTML-based web framework with .yawn templates",
  "license": "MIT",
  "author": "anythingQW (https://github.com/anythingQW)",
  "type": "module",
  "exports": {
    ".": {
      "import": "./packages/core/dist/index.js",
      "types": "./packages/core/dist/index.d.ts"
    },
    "./compiler": {
      "import": "./packages/compiler/dist/index.js",
      "types": "./packages/compiler/dist/index.d.ts"
    },
    "./reactivity": {
      "import": "./packages/reactivity/dist/index.js",
      "types": "./packages/reactivity/dist/index.d.ts"
    },
    "./router": {
      "import": "./packages/router/dist/index.js",
      "types": "./packages/router/dist/index.d.ts"
    },
    "./server": {
      "import": "./packages/server/dist/index.js",
      "types": "./packages/server/dist/index.d.ts"
    },
    "./dev-server": {
      "import": "./packages/dev-server/dist/index.js",
      "types": "./packages/dev-server/dist/index.d.ts"
    },
    "./runtime": {
      "import": "./packages/runtime/dist/index.js",
      "types": "./packages/runtime/dist/index.d.ts"
    },
    "./shared": {
      "import": "./packages/shared/dist/index.js",
      "types": "./packages/shared/dist/index.d.ts"
    }
  },
  "workspaces": [
    "packages/*"
  ],
  "keywords": [
    "yawn",
    "framework",
    "template",
    "ssr",
    "html",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yazilimhubb/yawn-framework.git"
  },
  "scripts": {
    "dev": "./yawnc/build/yawn dev",
    "build": "./yawnc/build/yawn build",
    "build:packages": "node scripts/build-packages.js",
    "release": "node scripts/release.js",
    "release:patch": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major",
    "release:dry": "node scripts/release.js patch --dry",
    "release:build": "node scripts/release.js patch --build-only",
    "publish:packages": "node scripts/publish.js",
    "publish:dry": "node scripts/publish.js --dry-run",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  },
  "files": [
    "packages/*/dist",
    "packages/*/src",
    "bin",
    "README.md",
    "LICENSE"
  ]
}
