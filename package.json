{
  "name": "yawn-framework",
  "version": "0.1.0",
  "private": false,
  "description": "A TypeScript HTML-based web framework with .yawn templates",
  "license": "MIT",
  "author": "anythingQW (https://github.com/anythingQW)",
  "type": "module",
  "bin": {
    "yawn": "./bin/yh.js",
    "yh": "./bin/yh.js"
  },
  "exports": {
    ".": "./packages/core/src/index.ts",
    "./reactivity": "./packages/reactivity/src/index.ts",
    "./router": "./packages/router/src/index.ts",
    "./compiler": "./packages/compiler/src/index.ts",
    "./server": "./packages/server/src/index.ts",
    "./dev-server": "./packages/dev-server/src/index.ts",
    "./runtime": "./packages/runtime/src/index.ts",
    "./shared": "./packages/shared/src/index.ts"
  },
  "workspaces": [
    "packages/*"
  ],
  "keywords": [
    "yawn",
    "framework",
    "template",
    "ssr",
    "html",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yazilimhubb/yawn-framework"
  },
  "scripts": {
    "dev": "yh dev",
    "build": "yh build",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  },
  "files": [
    "packages/*/src",
    "bin",
    "README.md",
    "LICENSE"
  ]
}
