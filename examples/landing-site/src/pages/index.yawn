  <!-- ── LIVE DEMO ──────────────────────────────────────────────────────────── -->
  <section id="demo" class="border-y border-white/[0.06] bg-[#050505] py-24">
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center mb-16">
        <p class="text-xs font-bold uppercase tracking-[.15em] text-indigo-400 mb-4">Canlı demo</p>
        <h2 class="text-4xl md:text-5xl font-black tracking-tight mb-4">Şimdi dene</h2>
        <p class="text-white/35 text-base">Bu sayfa Yawn ile yapıldı. Counter reaktif, kod gerçek.</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">

        <!-- counter -->
        <div class="bg-black border border-white/[0.08] rounded-2xl p-10 text-center">
          <p class="text-white/20 text-[10px] font-bold uppercase tracking-widest mb-8">Reactive Counter</p>
          <div class="text-[6.5rem] font-black tabular-nums leading-[1] mb-2
            {{ count > 0 ? 'text-indigo-400' : count < 0 ? 'text-red-400' : 'text-white' }}">
            {{ count }}
          </div>
          <p class="text-white/25 text-sm mb-8">
            {{ count === 0 ? 'Bir butona bas' : count > 0 ? count + ' kez arttırıldı' : 'Negatife gitti' }}
          </p>
          <div class="flex items-center justify-center gap-3 mb-6">
            <button @click="count--"
              class="w-13 h-13 w-12 h-12 rounded-xl bg-white/[0.05] hover:bg-red-500/15 hover:text-red-400 border border-white/[0.07] text-xl font-bold transition-all hover:scale-110">−</button>
            <button @click="count = 0"
              class="px-5 h-12 rounded-xl bg-white/[0.05] hover:bg-white/[0.1] border border-white/[0.07] text-sm font-bold transition-all">Reset</button>
            <button @click="count++"
              class="w-12 h-12 rounded-xl bg-indigo-500 hover:bg-indigo-400 text-xl font-bold transition-all hover:scale-110 hover:shadow-[0_0_20px_rgba(99,102,241,.5)]">+</button>
          </div>
          <div :if="count >= 10"
            class="inline-flex items-center gap-2 bg-green-500/10 border border-green-500/20 text-green-400 text-xs font-bold px-3 py-1.5 rounded-full">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            10'u geçtin!
          </div>
          <div :if="count <= -5"
            class="inline-flex items-center gap-2 bg-red-500/10 border border-red-500/20 text-red-400 text-xs font-bold px-3 py-1.5 rounded-full">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
            Çok negatif!
          </div>
        </div>

        <!-- code -->
        <div class="bg-[#0a0a0a] border border-white/[0.08] rounded-2xl overflow-hidden">
          <div class="flex items-center gap-2 px-5 py-3.5 border-b border-white/[0.06]">
            <div class="w-2.5 h-2.5 rounded-full bg-red-500/40"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-yellow-500/40"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-green-500/40"></div>
            <span class="ml-2 text-white/20 text-xs font-mono">index.yawn</span>
          </div>
          <pre class="p-6 text-sm font-mono leading-[1.8] overflow-x-auto text-white/50"><code><span class="text-white/20">&lt;template&gt;</span>
  &lt;div&gt;
    &lt;h1 :class=<span class="text-green-400">"count&gt;0?'text-indigo-400':'text-white'"</span>&gt;
      <span class="text-violet-400">{{ "{{ count }}" }}</span>
    &lt;/h1&gt;
    &lt;button <span class="text-indigo-400">@click</span>=<span class="text-green-400">"count++"</span>&gt;+&lt;/button&gt;
    &lt;button <span class="text-indigo-400">@click</span>=<span class="text-green-400">"count--"</span>&gt;−&lt;/button&gt;
    &lt;p <span class="text-orange-400">:if</span>=<span class="text-green-400">"count&gt;=10"</span>&gt;Harika!&lt;/p&gt;
    &lt;p <span class="text-orange-400">:else</span>&gt;Devam et&lt;/p&gt;
  &lt;/div&gt;
<span class="text-white/20">&lt;/template&gt;</span>

<span class="text-white/20">&lt;script&gt;</span>
  <span class="text-indigo-400">let</span> <span class="text-white/80">count</span> = <span class="text-orange-400">0</span>;
<span class="text-white/20">&lt;/script&gt;</span></code></pre>
        </div>

      </div>
    </div>
  </section>

