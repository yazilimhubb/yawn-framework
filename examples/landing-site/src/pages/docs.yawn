        <tbody class="divide-y divide-white/[0.04]">
          <tr><td class="px-5 py-3"><code class="text-violet-400 font-mono text-xs">{{ "{{ expr }}" }}</code></td><td class="px-5 py-3 text-white/40 text-xs">Reactive metin</td><td class="px-5 py-3 hidden sm:table-cell"><code class="text-white/25 font-mono text-xs">{{ "{{ count }}" }}</code></td></tr>
          <tr><td class="px-5 py-3"><code class="text-indigo-400 font-mono text-xs">@click</code></td><td class="px-5 py-3 text-white/40 text-xs">Tıklama olayı</td><td class="px-5 py-3 hidden sm:table-cell"><code class="text-white/25 font-mono text-xs">@click="count++"</code></td></tr>
          <tr><td class="px-5 py-3"><code class="text-indigo-400 font-mono text-xs">@input</code></td><td class="px-5 py-3 text-white/40 text-xs">Input olayı</td><td class="px-5 py-3 hidden sm:table-cell"><code class="text-white/25 font-mono text-xs">@input="name=event.target.value"</code></td></tr>
          <tr><td class="px-5 py-3"><code class="text-orange-400 font-mono text-xs">:if</code></td><td class="px-5 py-3 text-white/40 text-xs">Koşullu render</td><td class="px-5 py-3 hidden sm:table-cell"><code class="text-white/25 font-mono text-xs">:if="count &gt; 0"</code></td></tr>
          <tr><td class="px-5 py-3"><code class="text-orange-400 font-mono text-xs">:else</code></td><td class="px-5 py-3 text-white/40 text-xs">Else dalı</td><td class="px-5 py-3 hidden sm:table-cell"><code class="text-white/25 font-mono text-xs">&lt;p :else&gt;Boş&lt;/p&gt;</code></td></tr>
          <tr><td class="px-5 py-3"><code class="text-green-400 font-mono text-xs">:each</code></td><td class="px-5 py-3 text-white/40 text-xs">Döngü</td><td class="px-5 py-3 hidden sm:table-cell"><code class="text-white/25 font-mono text-xs">:each="item in items"</code></td></tr>
          <tr><td class="px-5 py-3"><code class="text-cyan-400 font-mono text-xs">:model</code></td><td class="px-5 py-3 text-white/40 text-xs">İki yönlü bağlama</td><td class="px-5 py-3 hidden sm:table-cell"><code class="text-white/25 font-mono text-xs">:model="name"</code></td></tr>
          <tr><td class="px-5 py-3"><code class="text-pink-400 font-mono text-xs">:class</code></td><td class="px-5 py-3 text-white/40 text-xs">Dinamik class</td><td class="px-5 py-3 hidden sm:table-cell"><code class="text-white/25 font-mono text-xs">:class="active?'bg-indigo-500':''"</code></td></tr>
          <tr><td class="px-5 py-3"><code class="text-yellow-400 font-mono text-xs">:bind:attr</code></td><td class="px-5 py-3 text-white/40 text-xs">Dinamik attribute</td><td class="px-5 py-3 hidden sm:table-cell"><code class="text-white/25 font-mono text-xs">:bind:src="imageUrl"</code></td></tr>
