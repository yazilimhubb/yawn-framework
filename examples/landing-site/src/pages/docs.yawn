      <pre class="p-6 text-sm font-mono leading-[1.85] overflow-x-auto text-white/50"><code><span class="text-white/20">&lt;meta&gt;</span>
  <span class="text-white/35">title: My Page</span>
  <span class="text-white/35">description: Page description</span>
<span class="text-white/20">&lt;/meta&gt;</span>

<span class="text-white/20">&lt;template&gt;</span>
  &lt;div&gt;
    &lt;h1&gt;<span class="text-violet-400">{{ "{{ title }}" }}</span>&lt;/h1&gt;
    &lt;button <span class="text-indigo-400">@click</span>=<span class="text-green-400">"count++"</span>&gt;(<span class="text-violet-400">{{ "{{ count }}" }}</span>)&lt;/button&gt;
    &lt;p <span class="text-orange-400">:if</span>=<span class="text-green-400">"count &gt; 3"</span>&gt;Harika!&lt;/p&gt;
    &lt;p <span class="text-orange-400">:else</span>&gt;Devam et&lt;/p&gt;
  &lt;/div&gt;
<span class="text-white/20">&lt;/template&gt;</span>

<span class="text-white/20">&lt;script&gt;</span>
  <span class="text-indigo-400">let</span> <span class="text-white/80">title</span> = <span class="text-green-400">"Merhaba Yawn"</span>;
  <span class="text-indigo-400">let</span> <span class="text-white/80">count</span> = <span class="text-orange-400">0</span>;
<span class="text-white/20">&lt;/script&gt;</span>

<span class="text-white/20">&lt;style&gt;</span>
  <span class="text-white/35">h1 { font-size: 2rem; }</span>
<span class="text-white/20">&lt;/style&gt;</span></code></pre>
